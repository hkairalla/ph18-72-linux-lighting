[Unit]
Description=Restore PH18-72 keyboard and MagKey lighting on login
# Run after the graphical session is up so the user has hidraw access via the
# logind ACL applied by the project's udev rule (70-ph18-72-lighting.rules).
After=graphical-session.target

[Service]
Type=oneshot
# The script finds the daemon binary and retries while the USB device settles.
# %h expands to the user's home directory; override ExecStart= in a drop-in
# (`systemctl --user edit ph18-lighting-restore.service`) if the repo lives
# somewhere else.
ExecStart=%h/Projects/ph18-72-linux-lighting/scripts/ph18-lighting-resume --now

[Install]
WantedBy=graphical-session.target
